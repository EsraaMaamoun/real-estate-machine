# Copy this file to `.env` and fill in ONE key.
#
#   .env          -> holds your real key, excluded by .gitignore, NEVER committed
#   .env.example  -> this file, safe to commit, shows what .env should contain
#
# Free keys:
#   Gemini -> Google AI Studio
#   Groq   -> the Groq console
#
# Fill in whichever one you have; app/llm_explain.py prefers Gemini if both are set.

GEMINI_API_KEY=
GROQ_API_KEY=

# Optional. Provider model names change; if a call fails with "model not found",
# run `python app/llm_explain.py --list-models` and paste a current name here.
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
