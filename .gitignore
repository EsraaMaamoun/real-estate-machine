# Environments
venv/
.venv/
env/

# Secrets — NEVER commit these
.env
*.key
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Editors
.vscode/
.idea/

# Large intermediates (keep the raw source files tracked)
*.pkl.bak

# Personal prep / process notes — not app documentation, not meant to be published.
SETUP.md
DEFENSE.md
reports/DECK_REVIEW.md
PREP_NOTES_FROM_NOTEBOOKS.md

# Models/ and Data/: only the files the deployed app actually needs are committed.
# Everything else in these two folders is an intermediate artifact from the dev
# notebooks (baseline comparisons, alternate models, raw/intermediate data) that the
# app never reads — ignored by default, with the required files explicitly kept.
Models/*
!Models/regressor.pkl
!Models/regressor_config.pkl
!Models/cluster_pipeline.pkl
!Models/cluster_config.pkl
!Models/reference_stats.pkl
!Models/segment_intervals.pkl

Data/*
!Data/data_clean.csv
!Data/split_indices.csv

# reports/llm_cache.json is NOT ignored: committing it lets the demo produce its
# explanation with no network at all. Delete the file first if you would rather not
# publish the generated text.
