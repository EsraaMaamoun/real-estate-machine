# Copy of what goes in the Secrets box on Streamlit Community Cloud
# (App menu -> Settings -> Secrets), in TOML.
#
# You do NOT need this file locally: locally the key comes from `.env`.
# It exists so the format is written down somewhere you can find it.
#
# If you do create `.streamlit/secrets.toml` on your own machine, note that
# `.gitignore` excludes it — a real secrets file must never be committed.

GEMINI_API_KEY = "paste-your-key-here"

# GROQ_API_KEY = "paste-your-key-here"

# Optional — only if the provider retires the default model name.
# GEMINI_MODEL = "gemini-2.5-flash"
# GROQ_MODEL = "llama-3.3-70b-versatile"
